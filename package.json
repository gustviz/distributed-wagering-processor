{
  "name": "wagering-processor",
  "version": "1.0.0",
  "private": true,
  "description": "Distributed wagering processor \u2014 Jungle Gaming backend challenge",
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "migrate:up": "bun run src/infrastructure/persistence/migrate.ts up",
    "migrate:down": "bun run src/infrastructure/persistence/migrate.ts down",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 150000",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test --timeout 60000 test/integration",
    "test:concurrency": "bun test --timeout 120000 test/concurrency",
    "test:all": "bun test --timeout 150000",
    "test:load": "bun run test/load/load-test.ts",
    "queues:create": "bun run scripts/create-queues.ts",
    "smoke": "bun run scripts/smoke.ts"
  },
  "engines": {
    "bun": ">=1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "typescript": "5.9"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3",
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/migrations": "6.6.17",
    "@mikro-orm/postgresql": "6.6.17",
    "@nestjs/common": "11",
    "@nestjs/core": "11",
    "@nestjs/platform-express": "11",
    "express": "5",
    "pg": "8",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "3"
  }
}
