# --- Runtime (defaults shown) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5433/wagering
DB_POOL_MAX=20
DB_LOCK_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
PORT=3000
LOG_LEVEL=info

AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_TRANSACTIONS_QUEUE=wager-transactions.fifo
SQS_TRANSACTIONS_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wager-events.fifo

# Roles (the same image can run any subset)
HTTP_ENABLED=true
CONSUMER_ENABLED=true
OUTBOX_RELAY_ENABLED=true
PENDING_REFERENCE_WORKER_ENABLED=true

# Consumer
SQS_WAIT_TIME_SECONDS=10
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_MAX_MESSAGES=10
SQS_MAX_ATTEMPTS=5
SQS_RETRY_BASE_DELAY_SECONDS=2
SQS_RETRY_MAX_DELAY_SECONDS=60
SHUTDOWN_GRACE_MS=20000

# Outbox relay
OUTBOX_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=100
OUTBOX_RETRY_BASE_DELAY_MS=1000
OUTBOX_RETRY_MAX_DELAY_MS=60000

# Pending-reference worker
PENDING_REFERENCE_INTERVAL_MS=1000
PENDING_REFERENCE_BATCH_SIZE=20
PENDING_REFERENCE_LEASE_MS=30000
PENDING_REFERENCE_MAX_ATTEMPTS=10
PENDING_REFERENCE_BASE_DELAY_MS=2000
PENDING_REFERENCE_MAX_DELAY_MS=300000

# --- Tests ---
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/wagering_test
